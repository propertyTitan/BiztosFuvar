# --- Server ---
PORT=4000
NODE_ENV=development
JWT_SECRET=change-me-in-production

# CORS: vesszővel elválasztott lista a megengedett origin-ekről.
# Üresen hagyva minden origin (lokális fejlesztéshez).
# Prod példa: https://gofuvar.hu,https://www.gofuvar.hu
CORS_ORIGIN=

# --- PostgreSQL / Supabase / Neon / Railway ---
DATABASE_URL=postgres://user:password@localhost:5432/gofuvar
# Prod hostolt Postgres (Neon, Supabase, Railway, Render) SSL-t igényel.
# Állítsd `require`-re, vagy tedd a DATABASE_URL végére: ?sslmode=require
PGSSL=

# --- Google Gemini ---
# API kulcs a https://aistudio.google.com/app/apikey oldalról.
# Aktuális modell: gemini-2.5-flash (default). Nagyobb: gemini-2.5-pro.
# A gemini-1.5-* és gemini-2.0-* sorozatokat a Google kivezette.
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-2.5-flash
# Opcionális: külön kulcs (lehetőleg külön Google Cloud projektből) a
# support-chathez, hogy a chat kvóta-kimerülése ne futtassa 429-re a
# KYC-ellenőrzést. Üresen a chat is a GEMINI_API_KEY-t használja.
GEMINI_CHAT_API_KEY=

# --- Email (Resend) ---
# Tranzakciós email küldéshez. Hagyd üresen STUB módhoz: fejlesztés
# közben a maileket csak a konzolra logolja (nem megy el a Resendre).
# Kulcs a https://resend.com/api-keys oldalról, saját EMAIL_FROM-hoz
# előbb verify-olj egy domain-t a dashboardon.
RESEND_API_KEY=
EMAIL_FROM=GoFuvar <onboarding@resend.dev>

# --- Google Maps ---
GOOGLE_MAPS_API_KEY=your-google-maps-key

# --- Delivery validation ---
DELIVERY_MAX_DISTANCE_METERS=50

# --- Barion Bridge (fizetés) ---
# Hagyd üresen STUB módhoz (fejlesztéskor sandbox nélkül is működik).
BARION_POS_KEY=
BARION_ENV=test                          # test | prod
BARION_PLATFORM_PAYEE=platform@gofuvar.hu
BARION_RESERVATION_PERIOD=1.00:00:00     # 1 nap (Barion ISO 8601 timespan)
PLATFORM_COMMISSION_PCT=0.10             # 10% jutalék
WEB_BASE_URL=http://localhost:3000
API_BASE_URL=http://localhost:4000

# --- Cloudflare R2 object storage (képek, avatárok) ---
# Ha mind az 5 változó kitöltött → R2-re töltjük a feltöltött képeket.
# Ha bármelyik hiányzik → lokális disk fallback (dev módhoz).
# Railway-en (ephemeral FS) mindenképp R2 kell, különben a képek
# minden redeploy után eltűnnek.
#
# Regisztráció: https://dash.cloudflare.com → R2 → Create bucket
# API Token: R2 → Manage R2 API Tokens → Create API Token → Object Read & Write
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=gofuvar-uploads
R2_PUBLIC_URL=

# --- Sentry (error monitoring) ---
# Ha be van állítva, minden uncaught hiba és unhandledRejection a Sentry-be megy.
# DSN: https://sentry.io → Project → Settings → Client Keys (DSN)
SENTRY_DSN=

# ── Segélyszolgálat (towing) ───────────────────────────────────────────
# A funkció ALAPBÓL KI VAN KAPCSOLVA: a végpontok 503-at adnak, amíg ez az
# érték nem `true`. Ok (2026-08-09 audit): a towing-ág nem szed
# kapcsolatfelvételi díjat, elvállaláskor viszont kiadja a mentős nevét és
# telefonszámát — vagyis a platform egyetlen bevétele megkerülhető rajta.
# Csak a díj-kérdés megoldása után kapcsolható be.
TOWING_ENABLED=
# Járat-ág (2026-09-11): élesben rejtett a launchra; visszakapcsolás: true (a webes NEXT_PUBLIC_JARAT_ENABLED-del EGYÜTT)
JARAT_ENABLED=true

# ── Teljes audit (2026-09-11) — új, opcionális hangolók ────────────────────
# E-mail újrapróba backoff (ms, vesszővel; alap 1000,4000) — A3
# EMAIL_RETRY_BACKOFF_MS=1000,4000
# Fizetetlen megállapodás lejárata a 2. emlékeztető után (óra, alap 72) — A4
# PAYMENT_EXPIRE_AFTER_HOURS=72
# Fotó-plafon típusonként és ügyletenként (alap 10) — A4
# PHOTO_MAX_PER_KIND=10
# Vita-nyitás riasztó e-mail címzettje (alap panasz@gofuvar.hu) — A2
# DISPUTE_ALERT_EMAIL=panasz@gofuvar.hu
# „Nincs ajánlat" tipp ennyi óra után (alap 24) — B3
# NO_OFFER_NUDGE_AFTER_HOURS=24
# ── Üzemeltetés (2026-09-13, teljes audit D4) ─────────────────────────────
# Külső HTTP-hívások (Resend, SeeMe, Expo push) időkerete ms-ban (alap 10000)
# KULSO_HTTP_TIMEOUT_MS=10000
# DB-pool időkeretek ms-ban (alap 5000 / 30000 / 10000)
# DB_CONNECT_TIMEOUT_MS=5000
# DB_QUERY_TIMEOUT_MS=30000
# DB_IDLE_TIMEOUT_MS=10000
# Socket-eredetű DB-munka korlátai (2026-09-28, audit P1) — a websocketre a
# HTTP rate limit nem hat, ezek védik a poolt a socket-áradattól.
# Egyszerre futó socket-lekérdezés a folyamatban (alap 4, max a pool negyede)
# SOCKET_DB_MAX_INFLIGHT=4
# Várakozó socket-lekérdezések plafonja; felette csendes eldobás (alap 256)
# SOCKET_DB_MAX_QUEUE=256
# job:join socketenként: löket / utántöltés mp-enként / függő plafon (alap 64 / 8 / 32)
# SOCKET_JOIN_BURST=64
# SOCKET_JOIN_PER_SEC=8
# SOCKET_JOIN_MAX_PENDING=32
# Függő job:join fiókonként, az összes socketjén együtt (alap 64)
# SOCKET_JOIN_MAX_PENDING_PER_USER=64
# Ennyi elutasított job:join után a socketet bontjuk (alap 500)
# SOCKET_JOIN_STRIKE_LIMIT=500
# Egy fiók egyidejű hitelesített socketjei; felette vendég (alap 20)
# SOCKET_MAX_PER_USER=20
# Idő-alapú körök bevezetés-dátuma (csak az ez utáni sorokra hatnak)
# PAYMENT_EXPIRY_SINCE=2026-09-11
# NO_OFFER_NUDGE_SINCE=2026-09-12

# CIB eCommerce (EKI / SAKI 1.50) kártyás díjfizetés (2026-09-28: a titkosító
# réteg — services/ekiCrypt.js; 2026-09-29: a fizetési folyamat bekötve —
# services/cibFizetes.js + cibLekerdezo.js). A kulcsfájlt (.des, 38 bájt) base64-ben tároljuk:
#   base64 -i TIH.des
# A teszt és az éles kulcs a banknál AZONOS fájlnévvel jön — külön kezelendő.
# SOHA ne kerüljön a repóba (a .gitignore a *.des-t kizárja).
# CIB_PID=
# CIB_KEY_B64=
# Teszt: https://ekit.cib.hu/market.saki és https://ekit.cib.hu/customer.saki
# Éles (CIB_KORNYEZET=eles): a host PONTOSAN az engedélylistán lévő legyen —
# ma eki.cib.hu (cibProtokoll.CIB_ELES_HOSTOK; a bank e-mailben erősíti meg).
# Hasonmás, porttal megadott vagy ponttal végződő host → hibás konfig (503).
# Ha a bank más éles hostot ad, az engedélylista KÓDBAN bővül (review-val).
# CIB_MARKET_URL=
# CIB_CUSTOMER_URL=
# 2026-09-29 (PR-2/A): a CIB-mód a fenti négy + az alábbi három változóval
# „teljes"; bármelyik hiánya vagy hibája „hibás" mód (503, a stub sem nyílik
# vissza). Egyik sincs → „nincs" (stub, mint eddig). Érték SOHA ne kerüljön ide.
# teszt | eles — induláskor a hosttal összevetve (teszt: ekit.cib.hu)
# CIB_KORNYEZET=
# A bank URL-mezője, query nélkül: https://<api-host>/payments/cib/vissza
# Élesben az API hostján (a WEB_BASE_URL domainjének aldomainje, pl.
# api.gofuvar.hu), port nélkül — SOHA nem a web hostján (www / apex): ott a
# hop-link és a visszatérés a webre menne (minden fizetés 404) → hibás konfig.
# CIB_RETURN_URL=
# Legalább 32 bájtos titok (eredmény-token, UID-álnév, hop-link)
# CIB_HMAC_TITOK=
# Opcionális: a kulcs SHA-256-jának első 12+ hexa jegye (eltérés → hibás mód).
# Élesben a bank ismert TESZT-kulcsa (5540ea8b5541…) hibás konfig.
# CIB_KEY_UJJLENYOMAT=
# Opcionális, CSAK teszt-környezetben hat: user-ID-k (UUID, NEM e-mail-cím)
# vesszővel — a többiek stubot kapnak. 2026-10-03 (PR-5/B) FAIL-CLOSED: ha be
# van állítva, de egyetlen érvényes UUID sincs benne, vagy éles futásban
# (NODE_ENV=production) üres / hiányzik → SENKI nem kapja a banki (tesztkártyás)
# utat, és induláskor hangos hiba + Sentry jelzi. Nem éles futásban (helyi
# fejlesztés, hamis bank) a hiányzó lista „mindenki".
# CIB_TESZT_FELHASZNALOK=
# Opcionális: riasztási cím (alap info@gofuvar.hu), TS-időzóna (alap Europe/Budapest)
# CIB_RIASZTAS_EMAIL=
# CIB_TS_IDOZONA=
# Hangolók (alapértékkel): CIB_HTTP_TIMEOUT_MS=30000, CIB_ZARAS_TIMEOUT_MS=45000,
# CIB_INDITAS_OSSZKERET_MS=40000, CIB_LEKERDEZES_KOZ_MS=60000, CIB_KOR_TICK_MS=30000,
# CIB_KOR_MAX_KERES=10, CIB_KISERLET_MAX_PERC=30, CIB_HOP_TTL_MP=120,
# CIB_MAX_INDITAS_ORANKENT=6, CIB_MAX_INDITAS_NAPONTA=20, CIB_EXTRA01=false,
# CIB_SIKERTELEN_LEZARAS=true, CIB_BEVEZETES=2026-09-29, CIB_ZARAS_HATARIDO_MP=570,
# CIB_EGYEZTETES_PERC=25, CIB_UJ_FIZETES_TILTVA=false
# 2026-10-03 (PR-5) határok: CIB_HTTP_TIMEOUT_MS és CIB_ZARAS_TIMEOUT_MS
# 1000–60000, CIB_INDITAS_OSSZKERET_MS 1000–50000 (a web 55 mp után feladja a
# /pay-t), CIB_LEKERDEZES_KOZ_MS 5000–180000 (a bank szerint 1–3 perc),
# CIB_KOR_TICK_MS 5000–60000; a tick + köz + HTTP + zárás összege a zárási
# ablakba férjen (CIB_ZARAS_HATARIDO_MP − 30 mp), különben a négy az
# alapértékre áll (figyelmeztetéssel). A DB-bérlet a leghosszabb banki hívás
# + 30 mp (alapból 75 mp, legalább 60).
# CIB_EGYEZTETES_PERC (20–120, alap 25; a tartományon kívüli érték → 25): a
# kétes (close_unknown) kísérlet automatikus egyeztetése az UTOLSÓ kimenő MSGT32
# után ennyi perccel — egy CSAK-OLVASÓ MSGT33 (MSGT32 soha): TO → „nem terhelt"
# (a fuvar újra fizethető); 00 + egyező AMO + ANUM → az első csak feljegyzés,
# és legalább 15 perccel később egy MEGERŐSÍTŐ 00 ugyanazzal az ANUM-mal →
# lezárt + könyvelés; minden más (TO-tól eltérő elutasító kód, mezőeltérés,
# eltérő ANUM) → riasztás + visszalépés (15 perc × 2^n, legfeljebb 6 óra), a
# fuvar fagyva marad. 2026-10-04: a valódi teszt-banknál a le nem zárt
# jóváhagyás a JÓVÁHAGYÁSHOZ képest ~9–10,5 perc múlva fordul TO-ra (addig
# 00 + ANUM) — ezért a horgony a MSGT32, és legalább 20 perc.
# CIB_UJ_FIZETES_TILTVA=true: SZÜNET — új kártyás fizetés nem indul (a /pay
# 503 CIB_PAUSED, a fel nem használt hop-link sem visz a bankhoz), de a kör és
# a zárás a meglévő kísérleteket befejezi. FAIL-CLOSED: a nem értelmezhető
# érték (pl. „yes", „on") is SZÜNET, hangos boot-hibával — csak true/false/
# 1/0/igen/nem érvényes. A visszaállás és a teszt→éles
# átállás receptje: előbb ez, és csak ha az admin „Egyeztetésre vár" szűrője és
# az SQL-ellenőrzés is 0 nem végső kísérletet mutat (provider='cib' AND
# cib_state IS NOT NULL AND state IN ('pending','needs_review')), jöhet a CIB_*
# törlése / a kulcs-, host- és környezetváltás. Konfig nélkül maradt függő
# kísérletről induláskor és naponta riasztó levél megy; az adminban konfig
# nélkül is van könyvelés / lejáratás / rendezés / visszatérítés.
# 2026-10-01 (a CIB írásos válasza): „10 perc a lezárási határidő, ami a
# kapott 10-es üzenet beérkezésétől számítódik." A CIB_ZARAS_HATARIDO_MP
# (60–590, alap 570 = 9 perc 30 mp) a MSGT10-től számított helyi zárási
# ablak. ⚠️ A tick + köz + HTTP + zárás összegének (+ 30 mp) bele kell férnie:
# ha az alapértékű hangolókkal sem fér (kb. 195 mp alatt), a változó az
# alapértékre (570) ÁLL VISSZA, figyelmeztetéssel — rövid ablakhoz előbb a
# négy hangolót kell csökkenteni. Az ablak után MSGT32 nem megy ki (a MSGT32
# nélküli — vagy csak bizonyítottan ki sem ment MSGT32-vel rendelkező —
# kísérlet expired, a vásárlónak „nem
# terhelt"; a bankhoz eljuthatott zárás után close_unknown + riasztás). A
# MSGT32-re kapott S05 a bank szerint fel nem dolgozott zárás (az S04-et
# saját döntéssel soroljuk mellé): legfeljebb 3 MSGT32-ig, a határidőn belül,
# a rövid várakozás után újraküldjük. IP-regisztráció NEM kell, a teszt- és az
# éles végpont is a 443-as porton (https) érhető el — a CIB_MARKET_URL és a
# CIB_CUSTOMER_URL ezért port nélküli https:// cím.
# ⚠️ CIB_EXTRA01=true a fuvar rövid hivatkozását is elküldi a banknak — az
# adatkezelési tájékoztató 4/A. pontja ma ezt NEM sorolja a továbbított adatok
# közé: bekapcsolás előtt a tájékoztatót bővíteni kell (2026-10-01).
# Kivezetve (a kód nem olvassa, induláskor figyelmeztet): CIB_API_KEY, CIB_MERCHANT_ID, CIB_BASE_URL
# 2026-09-29 (PR-2/B): a hop-link és a visszatérés a CIB_RETURN_URL originjén
# (az API) él, az eredmény-oldal a WEB_BASE_URL-en (a www host!). A szabályos
# leállás egy futó MSGT32-t legfeljebb CIB_ZARAS_TIMEOUT_MS + 10 s-ig vár —
# a Railway-en ehhez RAILWAY_DEPLOYMENT_DRAINING_SECONDS=60 kell.
# 2026-09-29 (PR-2/C): a szabályos leállás a futó CIB-munkát (eredmény-
# rögzítés + könyvelés) is megvárja. A CIB_BEVEZETES (ÉÉÉÉ-HH-NN) a lekérdező
# kör ÉS a körből futó értesítés-helyreállítás küszöbe: élesítéskor az aznapi
# dátum. 2026-10-03 (PR-5/B): a mai napnál KÉSŐBBI dátum hibás konfig (503 +
# hangos boot-hiba) — eddig egy elgépelés némán kikapcsolta a kört, miközben
# a /pay tovább engedélyeztetett pénzt. A „mai nap" UTC szerint értendő (a DB
# is UTC-éjfélként veti össze): magyar idő szerint éjféltől 01:00-ig (télen),
# illetve 02:00-ig (nyáron) az aznapi dátum még „jövőbeli" — nappal élesíts.
# 2026-10-04: a kör és a szívverés-figyelő hibás boot-konfignál is ütemezett
# (üresjárat), így a dátum napján a konfig MAGÁTÓL teljes lesz, és a kör
# újraindítás nélkül dolgozni kezd. A CIB_BEVEZETES előtti, nem végső
# kísérletekről (amikhez a kör nem nyúl) induláskor és naponta riasztás megy.
# Ha a kör 3 percig nem fut le sikeresen, a CIB_RIASZTAS_EMAIL címre
# rendszer-riasztás megy (30 percenként legfeljebb egy). Az automatikus
# egyeztetés 2026-10-03 óta él (CIB_EGYEZTETES_PERC, lásd fent).
# A PID 4. karaktere 0 kell legyen (forintos terminál) — más devizájú PID-del
# a konfig hibás.
#
# RAILWAY_DEPLOYMENT_DRAINING_SECONDS — ÉLESÍTÉSI CHECKLIST (2026-10-03, PR-5/B):
# a Railway SERVICE-változója (a kód nem írhatja; ha hiányzik, a Railway 0 mp-et
# hagy a SIGTERM és a SIGKILL között). Legalább CIB_ZARAS_TIMEOUT_MS + 10 s,
# azaz alapértékkel 55, a zárási keret felső határával (60 s) 70; JAVASOLT: 60
# (vagy a megemelt zárási kerethez igazítva). Enélkül egy deploy a futó MSGT32-t
# megszakíthatja, és a tétel kétes (close_unknown) lesz: a fuvar fagyasztva, a
# feladó „egyeztetjük" üzenetet kap, és banki egyeztetés kell. Teljes
# CIB-konfignál a Railway-en minden induláskor hangos hiba + Sentry-
# figyelmeztetés jelzi, ha hiányzik vagy kevés (2026-09-29, PR-2 1. javítókör).
# Ellenőrzés: a boot-naplóban NE legyen „RAILWAY_DEPLOYMENT_DRAINING_SECONDS” sor.
# RAILWAY_DEPLOYMENT_DRAINING_SECONDS=60
