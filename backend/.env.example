# --- Server ---
PORT=4000
NODE_ENV=development
JWT_SECRET=change-me-in-production

# CORS: vesszővel elválasztott lista a megengedett origin-ekről.
# Üresen hagyva minden origin (lokális fejlesztéshez).
# Prod példa: https://gofuvar.hu,https://www.gofuvar.hu
CORS_ORIGIN=

# --- PostgreSQL / Supabase / Neon / Railway ---
DATABASE_URL=postgres://user:password@localhost:5432/gofuvar
# Prod hostolt Postgres (Neon, Supabase, Railway, Render) SSL-t igényel.
# Állítsd `require`-re, vagy tedd a DATABASE_URL végére: ?sslmode=require
PGSSL=

# --- Google Gemini ---
# API kulcs a https://aistudio.google.com/app/apikey oldalról.
# Aktuális modell: gemini-2.5-flash (default). Nagyobb: gemini-2.5-pro.
# A gemini-1.5-* és gemini-2.0-* sorozatokat a Google kivezette.
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-2.5-flash
# Opcionális: külön kulcs (lehetőleg külön Google Cloud projektből) a
# support-chathez, hogy a chat kvóta-kimerülése ne futtassa 429-re a
# KYC-ellenőrzést. Üresen a chat is a GEMINI_API_KEY-t használja.
GEMINI_CHAT_API_KEY=

# --- Email (Resend) ---
# Tranzakciós email küldéshez. Hagyd üresen STUB módhoz: fejlesztés
# közben a maileket csak a konzolra logolja (nem megy el a Resendre).
# Kulcs a https://resend.com/api-keys oldalról, saját EMAIL_FROM-hoz
# előbb verify-olj egy domain-t a dashboardon.
RESEND_API_KEY=
EMAIL_FROM=GoFuvar <onboarding@resend.dev>

# --- Google Maps ---
GOOGLE_MAPS_API_KEY=your-google-maps-key

# --- Delivery validation ---
DELIVERY_MAX_DISTANCE_METERS=50

# --- Barion Bridge (fizetés) ---
# Hagyd üresen STUB módhoz (fejlesztéskor sandbox nélkül is működik).
BARION_POS_KEY=
BARION_ENV=test                          # test | prod
BARION_PLATFORM_PAYEE=platform@gofuvar.hu
BARION_RESERVATION_PERIOD=1.00:00:00     # 1 nap (Barion ISO 8601 timespan)
PLATFORM_COMMISSION_PCT=0.10             # 10% jutalék
WEB_BASE_URL=http://localhost:3000
API_BASE_URL=http://localhost:4000

# --- Cloudflare R2 object storage (képek, avatárok) ---
# Ha mind az 5 változó kitöltött → R2-re töltjük a feltöltött képeket.
# Ha bármelyik hiányzik → lokális disk fallback (dev módhoz).
# Railway-en (ephemeral FS) mindenképp R2 kell, különben a képek
# minden redeploy után eltűnnek.
#
# Regisztráció: https://dash.cloudflare.com → R2 → Create bucket
# API Token: R2 → Manage R2 API Tokens → Create API Token → Object Read & Write
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=gofuvar-uploads
R2_PUBLIC_URL=

# --- Sentry (error monitoring) ---
# Ha be van állítva, minden uncaught hiba és unhandledRejection a Sentry-be megy.
# DSN: https://sentry.io → Project → Settings → Client Keys (DSN)
SENTRY_DSN=

# ── Segélyszolgálat (towing) ───────────────────────────────────────────
# A funkció ALAPBÓL KI VAN KAPCSOLVA: a végpontok 503-at adnak, amíg ez az
# érték nem `true`. Ok (2026-08-09 audit): a towing-ág nem szed
# kapcsolatfelvételi díjat, elvállaláskor viszont kiadja a mentős nevét és
# telefonszámát — vagyis a platform egyetlen bevétele megkerülhető rajta.
# Csak a díj-kérdés megoldása után kapcsolható be.
TOWING_ENABLED=
# Járat-ág (2026-09-11): élesben rejtett a launchra; visszakapcsolás: true (a webes NEXT_PUBLIC_JARAT_ENABLED-del EGYÜTT)
JARAT_ENABLED=true

# ── Teljes audit (2026-09-11) — új, opcionális hangolók ────────────────────
# E-mail újrapróba backoff (ms, vesszővel; alap 1000,4000) — A3
# EMAIL_RETRY_BACKOFF_MS=1000,4000
# Fizetetlen megállapodás lejárata a 2. emlékeztető után (óra, alap 72) — A4
# PAYMENT_EXPIRE_AFTER_HOURS=72
# Fotó-plafon típusonként és ügyletenként (alap 10) — A4
# PHOTO_MAX_PER_KIND=10
# Vita-nyitás riasztó e-mail címzettje (alap panasz@gofuvar.hu) — A2
# DISPUTE_ALERT_EMAIL=panasz@gofuvar.hu
# „Nincs ajánlat" tipp ennyi óra után (alap 24) — B3
# NO_OFFER_NUDGE_AFTER_HOURS=24
# ── Üzemeltetés (2026-09-13, teljes audit D4) ─────────────────────────────
# Külső HTTP-hívások (Resend, SeeMe, Expo push) időkerete ms-ban (alap 10000)
# KULSO_HTTP_TIMEOUT_MS=10000
# DB-pool időkeretek ms-ban (alap 5000 / 30000 / 10000)
# DB_CONNECT_TIMEOUT_MS=5000
# DB_QUERY_TIMEOUT_MS=30000
# DB_IDLE_TIMEOUT_MS=10000
# Socket-eredetű DB-munka korlátai (2026-09-28, audit P1) — a websocketre a
# HTTP rate limit nem hat, ezek védik a poolt a socket-áradattól.
# Egyszerre futó socket-lekérdezés a folyamatban (alap 4, max a pool negyede)
# SOCKET_DB_MAX_INFLIGHT=4
# Várakozó socket-lekérdezések plafonja; felette csendes eldobás (alap 256)
# SOCKET_DB_MAX_QUEUE=256
# job:join socketenként: löket / utántöltés mp-enként / függő plafon (alap 64 / 8 / 32)
# SOCKET_JOIN_BURST=64
# SOCKET_JOIN_PER_SEC=8
# SOCKET_JOIN_MAX_PENDING=32
# Függő job:join fiókonként, az összes socketjén együtt (alap 64)
# SOCKET_JOIN_MAX_PENDING_PER_USER=64
# Ennyi elutasított job:join után a socketet bontjuk (alap 500)
# SOCKET_JOIN_STRIKE_LIMIT=500
# Egy fiók egyidejű hitelesített socketjei; felette vendég (alap 20)
# SOCKET_MAX_PER_USER=20
# Idő-alapú körök bevezetés-dátuma (csak az ez utáni sorokra hatnak)
# PAYMENT_EXPIRY_SINCE=2026-09-11
# NO_OFFER_NUDGE_SINCE=2026-09-12

# CIB eCommerce (EKI / SAKI 1.50) kártyás díjfizetés (2026-09-28: a titkosító
# réteg kész — services/ekiCrypt.js; a fizetési folyamat bekötése a
# következő lépés). A kulcsfájlt (.des, 38 bájt) base64-ben tároljuk:
#   base64 -i TIH.des
# A teszt és az éles kulcs a banknál AZONOS fájlnévvel jön — külön kezelendő.
# SOHA ne kerüljön a repóba (a .gitignore a *.des-t kizárja).
# CIB_PID=
# CIB_KEY_B64=
# Teszt: https://ekit.cib.hu/market.saki és https://ekit.cib.hu/customer.saki
# (élesben a bank más címet ad — ezért beállítás, nem kódba írt érték)
# CIB_MARKET_URL=
# CIB_CUSTOMER_URL=
# 2026-09-29 (PR-2/A): a CIB-mód a fenti négy + az alábbi három változóval
# „teljes"; bármelyik hiánya vagy hibája „hibás" mód (503, a stub sem nyílik
# vissza). Egyik sincs → „nincs" (stub, mint eddig). Érték SOHA ne kerüljön ide.
# teszt | eles — induláskor a hosttal összevetve (teszt: ekit.cib.hu)
# CIB_KORNYEZET=
# A bank URL-mezője, query nélkül: https://<api-host>/payments/cib/vissza
# CIB_RETURN_URL=
# Legalább 32 bájtos titok (eredmény-token, UID-álnév, hop-link)
# CIB_HMAC_TITOK=
# Opcionális: a kulcs SHA-256-jának első 12+ hexa jegye (eltérés → hibás mód)
# CIB_KEY_UJJLENYOMAT=
# Opcionális, CSAK teszt-környezetben hat: user-id-k vesszővel (a többiek stubot kapnak)
# CIB_TESZT_FELHASZNALOK=
# Opcionális: riasztási cím (alap info@gofuvar.hu), TS-időzóna (alap Europe/Budapest)
# CIB_RIASZTAS_EMAIL=
# CIB_TS_IDOZONA=
# Hangolók (alapértékkel): CIB_HTTP_TIMEOUT_MS=30000, CIB_ZARAS_TIMEOUT_MS=45000,
# CIB_INDITAS_OSSZKERET_MS=40000, CIB_LEKERDEZES_KOZ_MS=60000, CIB_KOR_TICK_MS=30000,
# CIB_KOR_MAX_KERES=10, CIB_KISERLET_MAX_PERC=30, CIB_HOP_TTL_MP=120,
# CIB_MAX_INDITAS_ORANKENT=6, CIB_MAX_INDITAS_NAPONTA=20, CIB_EXTRA01=false,
# CIB_SIKERTELEN_LEZARAS=true, CIB_BEVEZETES=2026-09-29
# Kivezetve (a kód nem olvassa, induláskor figyelmeztet): CIB_API_KEY, CIB_MERCHANT_ID, CIB_BASE_URL
